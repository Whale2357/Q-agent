{
  "name": "q-agent",
  "private": true,
  "version": "0.1.0",
  "description": "Q-Agent monorepo — web + realtime",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "npm run build -w @q-agent/contracts",
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w @q-agent/web",
    "build": "npm run build --workspaces --if-present",
    "build:contracts": "npm run build -w @q-agent/contracts",
    "start:web": "npm run start -w @q-agent/web",
    "smoke": "node scripts/smoke-test.mjs",
    "check:deploy": "node scripts/check-deployment.mjs",
    "test": "node --test scripts/tests/*.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "overrides": {
    "postcss": "8.5.28"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
