# Browser WebSocket (local). On HTTPS sites use wss://your-realtime-host/v1/realtime
NEXT_PUBLIC_REALTIME_WS_URL=ws://127.0.0.1:8765/v1/realtime

# Server-only BFF → realtime
REALTIME_SERVICE_URL=http://127.0.0.1:8765
# Must match services/realtime REALTIME_API_KEY when set
REALTIME_API_KEY=
# Optional explicit allowlist of exact web origins behind a trusted reverse proxy.
# WEB_ALLOWED_ORIGINS=https://stein.example
