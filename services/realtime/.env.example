# Default providers: OpenAI Responses API + Audio Transcriptions API.
LLM_PROVIDER=openai
STT_PROVIDER=openai

# Local providers
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CONTEXT_MODEL=qwen3:4b
OLLAMA_GENERATOR_MODEL=qwen3:8b
OLLAMA_EVALUATOR_MODEL=qwen3:1.7b
CONTEXT_NUM_CTX=4096
GENERATOR_NUM_CTX=8192
EVALUATOR_NUM_CTX=4096
WHISPER_MODEL=turbo
WHISPER_DEVICE=auto

# OpenAI providers (server-side only; never expose this key to the browser)
OPENAI_API_KEY= 
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CONTEXT_MODEL=gpt-4o-mini
OPENAI_GENERATOR_MODEL=gpt-4o-mini
OPENAI_EVALUATOR_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# Server
REALTIME_HOST=0.0.0.0
REALTIME_PORT=8765
REALTIME_DB_PATH=data/q-agent.db
REALTIME_LANGUAGE=ko
# Comma-separated browser origins (Vercel domain in production)
CORS_ORIGIN=http://localhost:3000
# Shared secret with web BFF. Empty = open local mode (HTTP auth off).
REALTIME_API_KEY=
MAX_AUDIO_SESSIONS=2
SESSION_TTL_SECONDS=120
CONTEXT_INTERVAL_SECONDS=5
# Poll interval for generator loop; actual generation also needs context version↑
QUESTION_INTERVAL_SECONDS=5
# Min seconds between generate runs (context-version gated)
GENERATOR_MIN_INTERVAL_SECONDS=25
REEVALUATION_INTERVAL_SECONDS=60
# Final question display: silence threshold (seconds). User ask still works anytime.
SILENCE_TRIGGER_SECONDS=20

# Production example:
# CORS_ORIGIN=https://your-app.vercel.app
# REALTIME_API_KEY=long-random-secret
