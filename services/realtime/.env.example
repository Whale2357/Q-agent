# Default providers: OpenAI Responses API + Audio Transcriptions API.
LLM_PROVIDER=openai
STT_PROVIDER=openai

# Local providers
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CONTEXT_MODEL=qwen3:4b
OLLAMA_GENERATOR_MODEL=qwen3:8b
OLLAMA_EVALUATOR_MODEL=qwen3:1.7b
CONTEXT_NUM_CTX=4096
GENERATOR_NUM_CTX=8192
EVALUATOR_NUM_CTX=4096
WHISPER_MODEL=turbo
WHISPER_DEVICE=auto

# OpenAI providers (server-side only; never expose this key to the browser)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CONTEXT_MODEL=gpt-4o-mini
OPENAI_GENERATOR_MODEL=gpt-4o-mini
OPENAI_EVALUATOR_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# Server
REALTIME_HOST=0.0.0.0
REALTIME_PORT=8765
REALTIME_DB_PATH=data/q-agent.db
REALTIME_LANGUAGE=ko
CORS_ORIGIN=http://localhost:3000
CONTEXT_INTERVAL_SECONDS=5
QUESTION_INTERVAL_SECONDS=30
REEVALUATION_INTERVAL_SECONDS=60
