# Providers: local development keeps Ollama/faster-whisper; public CPU hosting uses openai.
LLM_PROVIDER=ollama
STT_PROVIDER=local

# Local providers
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
WHISPER_MODEL=turbo
WHISPER_DEVICE=auto

# OpenAI providers (set both providers to openai for CPU-only public deployment)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# Server
REALTIME_HOST=0.0.0.0
REALTIME_PORT=8765
REALTIME_DB_PATH=data/q-agent.db
REALTIME_LANGUAGE=ko
CORS_ORIGIN=http://localhost:3000
