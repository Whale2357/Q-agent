# --- Local (docker-compose / npm run) ---
EXTRACT_PORT=4001
ENGINE_PORT=4002
WEB_PORT=3000

# Web BFF → services (browser never calls these directly)
EXTRACT_SERVICE_URL=http://localhost:4001
ENGINE_SERVICE_URL=http://localhost:4002

# Service → shared
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

