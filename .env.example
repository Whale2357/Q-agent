# --- Local / Compose (web + realtime) ---
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000

# Shared secret between web BFF and realtime (leave empty for open local mode)
REALTIME_API_KEY=
MAX_AUDIO_SESSIONS=2
SESSION_TTL_SECONDS=120
MAX_TEXT_SESSIONS=2
MAX_PENDING_TICKETS=128
REALTIME_MAX_SESSION_SECONDS=7200
REALTIME_REQUEST_TIMEOUT_SECONDS=180

# Browser → realtime WebSocket (must be wss:// on HTTPS deployments)
NEXT_PUBLIC_REALTIME_WS_URL=ws://127.0.0.1:8765/v1/realtime

# Web BFF → realtime HTTP
REALTIME_SERVICE_URL=http://127.0.0.1:8765
REALTIME_PORT=8765
REALTIME_DB_PATH=data/q-agent.db
LLM_PROVIDER=openai
STT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CONTEXT_MODEL=gpt-4o-mini
OPENAI_GENERATOR_MODEL=gpt-4o-mini
OPENAI_EVALUATOR_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# Optional local provider settings (set LLM_PROVIDER=ollama and STT_PROVIDER=local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CONTEXT_MODEL=qwen3:4b
OLLAMA_GENERATOR_MODEL=qwen3:8b
OLLAMA_EVALUATOR_MODEL=qwen3:1.7b
CONTEXT_NUM_CTX=4096
GENERATOR_NUM_CTX=8192
EVALUATOR_NUM_CTX=4096
WHISPER_MODEL=turbo
WHISPER_DEVICE=auto
CONTEXT_INTERVAL_SECONDS=5
QUESTION_INTERVAL_SECONDS=5
GENERATOR_MIN_INTERVAL_SECONDS=25
REEVALUATION_INTERVAL_SECONDS=60
SILENCE_TRIGGER_SECONDS=20

NODE_ENV=development

# Production example:
# CORS_ORIGIN=https://your-app.vercel.app
# REALTIME_SERVICE_URL=https://realtime.example.com
# NEXT_PUBLIC_REALTIME_WS_URL=wss://realtime.example.com/v1/realtime
# REALTIME_API_KEY=long-random-secret
