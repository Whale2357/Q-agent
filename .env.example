# --- Local (docker-compose / npm run) ---
EXTRACT_PORT=4001
ENGINE_PORT=4002
WEB_PORT=3000

# Web BFF → services (browser never calls these directly)
EXTRACT_SERVICE_URL=http://localhost:4001
ENGINE_SERVICE_URL=http://localhost:4002
REALTIME_SERVICE_URL=http://127.0.0.1:8765
NEXT_PUBLIC_REALTIME_WS_URL=ws://127.0.0.1:8765/v1/realtime
REALTIME_PORT=8765
REALTIME_DB_PATH=data/q-agent.db
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
WHISPER_MODEL=turbo
WHISPER_DEVICE=auto
# WHISPER_COMPUTE_TYPE=int8

# Service → shared
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# LLM / STT (server-side only — never commit real keys)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
