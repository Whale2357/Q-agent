# --- Local (docker-compose / npm run) ---
EXTRACT_PORT=4001
ENGINE_PORT=4002
WEB_PORT=3000

# Web BFF → services (browser never calls these directly)
EXTRACT_SERVICE_URL=http://localhost:4001
ENGINE_SERVICE_URL=http://localhost:4002

# Service → shared
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Engine
# ENGINE_MODE=mock|live  (default: live if OPENAI_API_KEY else mock)
# ENGINE_MODEL=gpt-4o-mini
# ENGINE_MODEL_GENERATE=gpt-4o-mini
# ENGINE_MODEL_SCORE=gpt-4o-mini
# ENGINE_SCORE_THRESHOLD=0.65
# ENGINE_TOTAL_TIMEOUT_MS=35000
# ENGINE_GENERATE_TIMEOUT_MS=15000
# ENGINE_SCORE_TIMEOUT_MS=15000

# LLM / STT (server-side only — never commit real keys)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
