# --- Local (docker-compose / npm run) ---
EXTRACT_PORT=4001
ENGINE_PORT=4002
WEB_PORT=3000

# Web BFF → services (browser never calls these directly)
EXTRACT_SERVICE_URL=http://localhost:4001
ENGINE_SERVICE_URL=http://localhost:4002
REALTIME_SERVICE_URL=http://127.0.0.1:8765
NEXT_PUBLIC_REALTIME_WS_URL=ws://127.0.0.1:8765/v1/realtime
REALTIME_PORT=8765
REALTIME_DB_PATH=data/q-agent.db
LLM_PROVIDER=openai
STT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CONTEXT_MODEL=gpt-4o-mini
OPENAI_GENERATOR_MODEL=gpt-4o-mini
OPENAI_EVALUATOR_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# Optional local provider settings (set LLM_PROVIDER=ollama and STT_PROVIDER=local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CONTEXT_MODEL=qwen3:4b
OLLAMA_GENERATOR_MODEL=qwen3:8b
OLLAMA_EVALUATOR_MODEL=qwen3:1.7b
CONTEXT_NUM_CTX=4096
GENERATOR_NUM_CTX=8192
EVALUATOR_NUM_CTX=4096
WHISPER_MODEL=turbo
WHISPER_DEVICE=auto
# WHISPER_COMPUTE_TYPE=int8
CONTEXT_INTERVAL_SECONDS=5
QUESTION_INTERVAL_SECONDS=30
REEVALUATION_INTERVAL_SECONDS=60

# Service → shared
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Other LLM providers (server-side only — never commit real keys)
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
